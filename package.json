{
  "name": "@ultratestbro/wdk-protocol-staking-lido-evm",
  "version": "0.1.0",
  "description": "A simple package that lets @tetherto/wdk-wallet-evm wallet accounts stake through the Lido protocol: stake, two-phase queue withdrawals (permit-first), wrap/unwrap, rewards.",
  "keywords": [
    "wdk",
    "protocol",
    "staking",
    "lido",
    "steth",
    "ethereum",
    "wsteth",
    "staking-protocol"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultratestbro/wdk-protocol-staking-lido-evm.git"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "files": [
    "index.js",
    "bare.js",
    "src",
    "types",
    "tests",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "peerDependencies": {
    "@tetherto/wdk-wallet": ">=1.0.0-beta.13"
  },
  "devDependencies": {
    "@tetherto/wdk-wallet": "1.0.0-beta.17"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
